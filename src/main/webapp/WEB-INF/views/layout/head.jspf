<%@ page pageEncoding="UTF-8" %>
<%--
  Phần <head> dùng chung. Trang gọi đặt trước biến pageTitle.

  Biểu tượng trang nhúng thẳng dưới dạng SVG trong địa chỉ data: — không tốn thêm một lượt
  tải, và quan trọng hơn là không để trình duyệt gọi /favicon.ico rồi nhận 404 trên mọi lượt
  xem trang, làm log máy chủ đầy những dòng lỗi giả.

  Tham số ?v= lấy từ lúc máy chủ khởi động: sửa CSS hay JS xong chỉ cần khởi động lại Tomcat
  là trình duyệt tải bản mới, không phải bấm Ctrl+F5 và cũng không lo xem nhầm bản cũ.
--%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Đặt trước đồ ăn nhanh và hẹn giờ đến lấy tại cửa hàng.">
<meta name="theme-color" content="#d92d20">
<title><c:out value="${empty pageTitle ? 'Fast Food' : pageTitle}"/> · Fast Food</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8D%94%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="${ctx}/assets/css/main.css?v=${assetVersion}">
<script src="${ctx}/assets/js/app.js?v=${assetVersion}" defer></script>
